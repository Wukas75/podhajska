# Štúdiá Podhájska -- Apache rewrite pravidlá pre Websupport hosting.
#
# Tento súbor patrí do KOREŇA hostingu (tam, kam sa nahrá aj obsah `public/`
# a odtiaľto `api/`, `ics.php`, `lib/`, `uploads/`, `cron/` -- teda predpona
# "websupport/" sa pri nahrávaní na hosting NEPOUŽÍVA, tieto priečinky idú
# rovno do doc rootu vedľa index.html). Pozri ../README.md "Fáza 6/7" pre
# presné mapovanie pri nasadení.

RewriteEngine On

# podhajska.net -> www.podhajska.net (jedna kanonická adresa; predtým to robil
# WordPress). MUSÍ byť prvé: inak sa najprv prepíše /ics/1.ics -> ics.php a
# presmerovanie by viedlo na internú adresu. Query string Apache pripojí sám.
RewriteCond %{HTTP_HOST} ^podhajska\.net$ [NC]
RewriteRule ^ https://www.podhajska.net%{REQUEST_URI} [R=301,L,NE]

# Hlavná stránka cez index.php (SEO meta z DB, fáza 5); index.html ostáva
# statický zdroj, ktorý index.php načíta a upraví. /index.html -> 301 / (ako
# Cloudflare), takže aj tá adresa dostane SEO meta z index.php.
DirectoryIndex index.php index.html
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?]
RewriteRule ^index\.html$ / [R=301,L]

# /api/<cokolvek> -> jeden PHP front-controller (api/index.php)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^api/ api/index.php [QSA,L]

# /ics/<room_id>[.ics] -> verejný export kalendára izby
RewriteRule ^ics/([0-9]+)(\.ics)?$ ics.php?room=$1 [QSA,L]

# interné súbory (config.php, DB dump-y, cron skript) nikdy neservírovať
# priamo cez web -- jediné oficiálne vstupné body sú api/index.php, ics.php
# (cez rewrite vyššie) a cron/sync.php (spúšťa ho len Websupport Cron, nie
# HTTP požiadavka).
RewriteRule ^lib/ - [F,L]
RewriteRule ^db/ - [F,L]
RewriteRule ^cron/ - [F,L]

# adminom nahraté fotky -- statický obsah, žiadne PHP spúšťanie.
# (<Directory> v .htaccess nie je povolený -> 500 na celom webe, preto rewrite.)
RewriteRule ^uploads/.*\.(php[0-9]?|phtml|phar)$ - [F,L,NC]

# staré Cloudflare/R2 cesty fotiek (podhajska.pages.dev/img/gallery/… sa presmeruje sem)
RewriteRule ^img/gallery/(.+)$ /uploads/gallery/$1 [R=301,L]

# --- staré WordPress adresy (Google ich má v indexe) -> sekcie novej stránky ---
# NE = nekódovať "#" v cieli
RewriteRule ^bungalovy/?$ /#studia [R=301,L,NE]
RewriteRule ^okolie-a-aktivity/?$ /#okolie [R=301,L,NE]
RewriteRule ^galeria/?$ /#galeria [R=301,L,NE]
RewriteRule ^kontakt/?$ /#kontakt [R=301,L,NE]
RewriteRule ^blog/?$ /#blog [R=301,L,NE]
RewriteRule ^[0-9]{4}/[0-9]{2}/[0-9]{2}/[^/]+/?$ /#blog [R=301,L,NE]
RewriteRule ^na-stranke-sa-pracuje-dakujeme-za-pochopenie/?$ / [R=301,L]
RewriteRule ^(wp-sitemap|sitemap_index|sitemap-index)\.xml$ /sitemap.xml [R=301,L]
RewriteRule ^(wp-admin|wp-login\.php) /admin [R=301,L]

# --- správanie ako Cloudflare Pages ---
# /x.html -> 301 /x (len pri priamej požiadavke z prehliadača, THE_REQUEST --
# interné prepisy nižšie tak nezacyklia)
RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.html[\s?]
RewriteRule ^ /%1 [R=301,L]

# /x/ -> 301 /x (ak to nie je skutočný priečinok)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# pekné URL: /admin -> admin.html (odkaz „Prihlásenie správcu" v pätičke)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

# neznáma cesta bez prípony (/studia, /clanok/…) -> hlavná stránka, ako SPA
# fallback na Pages; chýbajúce súbory s príponou (obrázky) ostávajú 404
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^[^.]*$ index.php [L]

# Cache: Websupport proxy (openresty) bez týchto hlavičiek drží staré CSS/JS
# aj po nasadení (overené 2026-09-23). Kód vždy revalidovať, obrázky týždeň.
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|mjs|html|json|txt|webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(jpe?g|png|gif|webp|avif|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
